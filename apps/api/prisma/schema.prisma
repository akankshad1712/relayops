
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENGINEER
  VIEWER
}

enum Severity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
  MAINTENANCE
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role            @default(ENGINEER)
  incidents      Incident[]      @relation("IncidentOwner")
  incidentEvents IncidentEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Service {
  id          String        @id @default(cuid())
  name        String        @unique
  description String
  team        String
  status      ServiceStatus @default(OPERATIONAL)
  uptime      Float         @default(99.95)
  incidents   Incident[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Incident {
  id        String         @id @default(cuid())
  title     String
  summary   String
  severity  Severity
  status    IncidentStatus @default(INVESTIGATING)
  serviceId String
  service   Service        @relation(fields: [serviceId], references: [id])
  ownerId   String
  owner     User           @relation("IncidentOwner", fields: [ownerId], references: [id])
  startedAt DateTime       @default(now())
  resolvedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    IncidentEvent[]

  @@index([status, severity, createdAt])
  @@index([serviceId, createdAt])
}

/// Append-only lifecycle events for incident auditability and post-incident review.
model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  type       String   @db.VarChar(64)
  message    String   @db.VarChar(1000)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([actorId, createdAt])
}
